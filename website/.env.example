# Same Supabase project as the Flutter app (copy values from repo root .env).

# Browser-safe (Vite embeds these in the client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only for Vite admin middleware (/api/admin/*). Do NOT prefix with VITE_.
# Without this, Overview / Verification / Reports cannot bypass RLS.
SUPABASE_SECRET_KEY=your-service-role-key
