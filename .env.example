# Copy to .env and fill in your values (never commit .env).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service role key — admin website / server only. Never ship in the Flutter app.
# Same project as above. See docs/ADMIN_PANEL.md.
SUPABASE_SECRET_KEY=

# Password reset deep link used by the app: hupworks://reset-password
# Add that exact URL under Supabase → Authentication → URL Configuration → Redirect URLs.

# Tawk.to direct chat links for Help & Support live chat tab.
# Widget UI language is set per widget in tawk.to (Administration → Chat Widget
# → Widget Content → Language). Create one widget per app language, then paste
# each Direct Link here. The app picks the link matching Settings → language.
#
# English (default / fallback): https://tawk.to/chat/PROPERTY_ID/WIDGET_ID
TAWK_DIRECT_CHAT_LINK=
# Dutch (Nederlands widget — set widget language to Nederlands in dashboard):
TAWK_DIRECT_CHAT_LINK_NL=
# Bengali (optional):
TAWK_DIRECT_CHAT_LINK_BN=
